# ─── Cloudflare Pages Headers ─────────────────────────────────────────────────
# Equivalent of vercel.json headers block, adapted for Cloudflare Pages.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

# Service worker must never be cached by the browser
/service-worker.js
  Cache-Control: public, max-age=0, must-revalidate

# HTML shells must be revalidated every load to pick up new JS bundles
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Expo static assets are content-hashed and immutable
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable

# Version API must never be cached
/api/*
  Cache-Control: public, max-age=0, must-revalidate
