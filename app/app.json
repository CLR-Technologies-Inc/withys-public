{
  "expo": {
    "name": "WWLO PRM",
    "slug": "prm-journal",
    "version": "0.14.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "prm-journal",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.prmjournal.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.prmjournal.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "WWLO PRM",
      "shortName": "WWLO PRM",
      "themeColor": "#000000",
      "backgroundColor": "#000000",
      "display": "standalone",
      "startUrl": "/"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow WWLO PRM to access your microphone for voice recordings."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}